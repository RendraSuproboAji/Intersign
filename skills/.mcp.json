{
  "mcpServers": {
    "intersign": {
      "type": "stdio",
      "command": "intersign",
      "args": ["mcp", "connect"]
    },
    "intersign-hosted": {
      "type": "http",
      "url": "https://editor.pascal.app/api/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.intersign_api_key}"
      }
    }
  }
}
