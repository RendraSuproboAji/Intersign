{
  "mcpServers": {
    "intersign": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "--package=@intersign/cli@1.0.0",
        "intersign",
        "mcp",
        "connect"
      ]
    },
    "intersign-hosted": {
      "type": "http",
      "url": "https://editor.pascal.app/api/mcp",
      "auth": {
        "CLIENT_ID": "intersign-cursor",
        "scopes": [
          "openid",
          "profile",
          "offline_access",
          "scene:read",
          "scene:write"
        ]
      }
    }
  }
}
