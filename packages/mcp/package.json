{
  "name": "@intersign/mcp",
  "version": "1.0.3",
  "description": "Model Context Protocol server for Intersign 3D editor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./storage/types": {
      "types": "./dist/storage/types.d.ts",
      "import": "./dist/storage/types.js",
      "default": "./dist/storage/types.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations/index.js",
      "default": "./dist/operations/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js",
      "default": "./dist/bridge/index.js"
    }
  },
  "bin": {
    "intersign-mcp": "dist/bin/intersign-mcp.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build && bun ../../scripts/fix-node-esm-imports.ts ../core/dist && bun ../../scripts/fix-node-esm-imports.ts dist",
    "dev": "tsgo --build --watch",
    "start": "bun dist/bin/intersign-mcp.js",
    "test": "bun test",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:node": "node dist/bin/intersign-mcp.js --help",
    "prepublishOnly": "bun run build && bun test && bun run smoke:node"
  },
  "peerDependencies": {
    "@intersign/core": "^1.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pascal-app/lingo": "^0.2.0",
    "zod": ">=4.5.4 <4.6"
  },
  "devDependencies": {
    "@intersign/core": "^1.0.3",
    "@intersign/typescript-config": "*",
    "@types/node": "^22.19.20",
    "typescript": "6.0.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "intersign",
    "3d",
    "building",
    "editor",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RendraSuproboAji/Intersign.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "homepage": "https://github.com/RendraSuproboAji/Intersign/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/RendraSuproboAji/Intersign/issues"
}
