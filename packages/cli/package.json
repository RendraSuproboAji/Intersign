{
  "name": "@intersign/cli",
  "version": "1.0.3",
  "description": "Run the open-source Intersign 3D editor, local projects, and MCP agent tools from your terminal",
  "type": "module",
  "bin": {
    "intersign": "dist/bin/intersign.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "build-runtime": "cd ../../apps/editor && INTERSIGN_PORTABLE_BUILD=1 bun run build",
    "check-types": "tsc --build --pretty false && tsc --project tsconfig.scripts.json --pretty false",
    "stage-runtime": "bun run scripts/stage-runtime.ts",
    "smoke-runtime": "bun run scripts/smoke-packed-runtime.ts",
    "test": "bun test src",
    "prepublishOnly": "bun run check-types && bun run build && bun run test && bun run build-runtime && bun run stage-runtime && bun run smoke-runtime"
  },
  "devDependencies": {
    "@intersign/typescript-config": "*",
    "@types/node": "^22.19.20",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "intersign",
    "editor",
    "3d-editor",
    "3d",
    "architecture",
    "building-design",
    "cad",
    "bim",
    "local-first",
    "cli",
    "mcp",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RendraSuproboAji/Intersign.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": {
    "name": "Intersign",
    "url": "https://github.com/RendraSuproboAji/Intersign"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/RendraSuproboAji/Intersign",
  "bugs": "https://github.com/RendraSuproboAji/Intersign/issues"
}
